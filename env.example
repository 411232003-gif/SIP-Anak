# ===== Firebase Web config =====
# Memang bersifat publik (di-bundle ke client) — keamanan data dijamin
# oleh firestore.rules, bukan oleh kerahasiaan API key.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ===== Opsional: domain email sintetis =====
# Harus cocok dengan regex di firestore.rules jika diubah.
# NEXT_PUBLIC_ORTU_EMAIL_DOMAIN=sipanak.app
# NEXT_PUBLIC_PETUGAS_EMAIL_DOMAIN=petugas.sipanak.app

# ===== Kredensial admin untuk scripts/ (seed & backfill) =====
# PENTING: tanpa prefix NEXT_PUBLIC_ agar TIDAK ikut ter-bundle ke client.
# ADMIN_USERNAME boleh username (mis. admin) atau email asli akun admin.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ===== reCAPTCHA v2 (opsional — widget centang di halaman login) =====
# Site key memang publik; secret key JANGAN pakai NEXT_PUBLIC_ (khusus server).
# Daftarkan domain di reCAPTCHA Admin Console: localhost + domain Vercel.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=

# ===== Web Push / VAPID (opsional — notifikasi jadwal & hasil penimbangan) =====
# Buat keypair: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@sipanak.app
